{
  "name": "makeup-live-backend",
  "version": "1.0.0",
  "description": "Backend API for Makeup Live - Programming III integrative project",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:schema": "psql -U postgres -d makeup_live -f ../database/schema.sql",
    "db:seed": "psql -U postgres -d makeup_live -f ../database/seed.sql"
  },
  "keywords": ["node", "express", "postgresql", "socket.io", "jwt", "swagger"],
  "author": "Makeup Live Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
