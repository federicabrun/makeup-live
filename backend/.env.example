NODE_ENV=development
PORT=4000

# PostgreSQL local example
DATABASE_URL=postgres://postgres:postgres@localhost:5432/makeup_live

# JWT
JWT_SECRET=change_this_secret_for_production
JWT_EXPIRES_IN=2h

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5500

# External APIs - optional
MAKEUP_API_URL=http://makeup-api.herokuapp.com/api/v1/products.json
YOUTUBE_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
